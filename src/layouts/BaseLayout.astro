---
import '@/styles/tokens.css';
import '@/styles/global.css';
import { siteUrl } from '@/content/site-config';
import type { PageContent } from '@/content/types';
import { asset } from '@/content/paths';

interface Props {
  site: PageContent['site'];
  /** Preloaded above-the-fold image */
  preloadImage?: string;
}

const { site, preloadImage } = Astro.props;
const ogImage = new URL(site.shareImage, Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Aayera',
  url: siteUrl,
  email: site.email,
  telephone: site.phones[0]?.label,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [site.address.street, site.address.area].filter(Boolean).join(', '),
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.countryCode,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.noindex && <meta name="robots" content="noindex" />}
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content={site.shareTitle} />
    <meta property="og:description" content={site.shareDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={asset('/favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&display=swap" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <slot />
    <script>
      import '@/scripts/intents';
      import '@/scripts/scroll-effects';
      import '@/scripts/marquee';
    </script>
  </body>
</html>
