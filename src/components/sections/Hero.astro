---
import Arrow from '@/components/ui/Arrow.astro';
import HeroNetwork from '@/components/islands/HeroNetwork';
import Crossfade from '@/components/islands/Crossfade';
import { heroRingLogos } from '@/data/clients';
import { reelSlides, stats } from '@/data/content';

const chips = [
  { angle: 35, label: 'Energy', path: 'M13 2 5 14h6l-1 8 8-12h-6Z' },
  { angle: 125, label: 'Mobility', path: 'm5 8 2-4h10l2 4 2 3v7H3v-7ZM3 12h18M7 18v2M17 18v2' },
  { angle: 215, label: 'Healthcare', path: 'M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z' },
];
---

<section class="hero dark">
  <HeroNetwork client:idle />

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-tag"><i aria-hidden="true"></i>The meeting point for industry</p>
      <h1 aria-label="The future doesn't happen alone.">
        <span aria-hidden="true">
          <span class="w" style="--i:0">The</span>{' '}
          <span class="w gold" style="--i:1">future</span><br />
          <span class="w" style="--i:2">doesn't</span>{' '}
          <span class="w" style="--i:3">happen</span><br />
          <span class="w alone" style="--i:4"
            ><span class="grad">alone.</span><svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"
              ><path pathLength="1" d="M4 14Q100 2 196 12"></path></svg
            ></span
          >
        </span>
      </h1>
      <p class="hero-sub">We bring people and ideas into the same room, through conferences, summits, training and exhibitions.</p>
      <div class="hero-actions">
        <a class="btn" href="#events">Discover our events <Arrow /></a>
        <a class="btn btn-line" href="#about">Learn more about us</a>
      </div>
    </div>

    <div class="orbit" aria-hidden="true">
      <svg class="orbit-lines" viewBox="0 0 100 100">
        <circle class="ol" cx="50" cy="50" r="43"></circle>
        <circle class="ol" cx="50" cy="50" r="33"></circle>
        <circle class="sweep" pathLength="1" cx="50" cy="50" r="28"></circle>
        <circle class="sweep rev" pathLength="1" cx="50" cy="50" r="43"></circle>
      </svg>

      <Crossfade client:load className="core" captionClass="core-cap" slides={reelSlides} priority />

      <div class="ring-logos">
        {heroRingLogos.map((src, i) => (
          <div class="arm" style={`--a:${i * 60}`}><span class="disc"><img src={src} alt="" /></span></div>
        ))}
      </div>

      <div class="ring-chips">
        {chips.map((c) => (
          <div class="arm" style={`--a:${c.angle}`}><span class="chip"><svg viewBox="0 0 24 24"><path d={c.path}></path></svg>{c.label}</span></div>
        ))}
        <div class="arm" style="--a:305">
          <span class="chip"
            ><svg viewBox="0 0 24 24"
              ><circle cx="12" cy="5" r="3"></circle><circle cx="5" cy="19" r="3"></circle><circle cx="19" cy="19" r="3"></circle><path
                d="m10 8-4 8M14 8l4 8M8 19h8"></path></svg
            >Technology</span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="rail" id="stats">
      {stats.map((s) => (
        <div class="stat">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {s.icon === 'cal' && (
              <Fragment><rect pathLength="1" x="3" y="5" width="18" height="16" rx="2" /><path pathLength="1" d="M8 2v6M16 2v6M3 11h18" /></Fragment>
            )}
            {s.icon === 'pin' && (
              <Fragment><path pathLength="1" d="M12 22s8-7.500 8-13a8 8 0 1 0-16 0c0 5.500 8 13 8 13Z" /><circle pathLength="1" cx="12" cy="9" r="3" /></Fragment>
            )}
            {s.icon === 'people' && (
              <Fragment><circle pathLength="1" cx="9" cy="8" r="3" /><path pathLength="1" d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v3" /></Fragment>
            )}
            {s.icon === 'globe' && (
              <Fragment><circle pathLength="1" cx="12" cy="12" r="9" /><ellipse pathLength="1" cx="12" cy="12" rx="4" ry="9" /><path pathLength="1" d="M3 12h18" /></Fragment>
            )}
          </svg>
          <div><dt>{s.label}</dt><dd data-count={s.value}>{s.value}</dd></div>
        </div>
      ))}
    </dl>
  </div>
</section>
