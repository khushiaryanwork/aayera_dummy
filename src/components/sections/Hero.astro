---
import Arrow from '@/components/ui/Arrow.astro';
import HeroNetwork from '@/components/islands/HeroNetwork';
import Crossfade from '@/components/islands/Crossfade';
import type { PageContent } from '@/content/types';

interface Props {
  hero: PageContent['hero'];
}
const { hero } = Astro.props;

// Headline: every word animates in turn; the highlight word is gold; the last line gets the gradient + underline.
const lines = hero.headlineLines;
const leadLines = lines.slice(0, -1).map((line) => line.split(/\s+/).filter(Boolean));
const lastLine = lines.at(-1) ?? '';
const wordCount = leadLines.flat().length;
const plainHeadline = lines.join(' ');
const isHighlight = (w: string) => !!hero.highlightWord && w.replace(/[^\p{L}\p{N}'’]/gu, '') === hero.highlightWord;

const chips = [
  { angle: 35, label: 'Energy', icon: 'energy' },
  { angle: 125, label: 'Mobility', icon: 'mobility' },
  { angle: 215, label: 'Healthcare', icon: 'health' },
  { angle: 305, label: 'Technology', icon: 'tech' },
];
let wordIndex = 0;
---

<section class="hero dark">
  <HeroNetwork client:idle />

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-tag"><i aria-hidden="true"></i>{hero.tagline}</p>
      <h1 aria-label={plainHeadline}>
        <span aria-hidden="true">
          {leadLines.map((words) => (
            <Fragment>
              {words.map((w, i) => (
                <Fragment>
                  <span class:list={['w', { gold: isHighlight(w) }]} style={`--i:${wordIndex++}`}>{w}</span>{i < words.length - 1 && ' '}
                </Fragment>
              ))}<br />
            </Fragment>
          ))}
          <span class="w alone" style={`--i:${wordCount}`}
            ><span class="grad">{lastLine}</span><svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"
              ><path pathLength="1" d="M4 14Q100 2 196 12"></path></svg
            ></span
          >
        </span>
      </h1>
      <p class="hero-sub">{hero.subheading}</p>
      <div class="hero-actions">
        <a class="btn" href="#events">{hero.primaryCta} <Arrow /></a>
        <a class="btn btn-line" href="#about">{hero.secondaryCta}</a>
      </div>
    </div>

    <div class="orbit" aria-hidden="true">
      <svg class="orbit-lines" viewBox="0 0 100 100">
        <circle class="ol" cx="50" cy="50" r="43"></circle>
        <circle class="ol" cx="50" cy="50" r="33"></circle>
        <circle class="sweep" pathLength="1" cx="50" cy="50" r="28"></circle>
        <circle class="sweep rev" pathLength="1" cx="50" cy="50" r="43"></circle>
      </svg>

      <Crossfade client:load className="core" captionClass="core-cap" slides={hero.reel} priority />

      <div class="ring-logos">
        {hero.ringLogos.map((src, i) => (
          <div class="arm" style={`--a:${Math.round((i * 360) / hero.ringLogos.length)}`}><span class="disc"><img src={src} alt="" /></span></div>
        ))}
      </div>

      <div class="ring-chips">
        {chips.map((c) => (
          <div class="arm" style={`--a:${c.angle}`}>
            <span class="chip">
              <svg viewBox="0 0 24 24">
                {c.icon === 'energy' && <path d="M13 2 5 14h6l-1 8 8-12h-6Z" />}
                {c.icon === 'mobility' && <path d="m5 8 2-4h10l2 4 2 3v7H3v-7ZM3 12h18M7 18v2M17 18v2" />}
                {c.icon === 'health' && <path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z" />}
                {c.icon === 'tech' && (
                  <Fragment><circle cx="12" cy="5" r="3" /><circle cx="5" cy="19" r="3" /><circle cx="19" cy="19" r="3" /><path d="m10 8-4 8M14 8l4 8M8 19h8" /></Fragment>
                )}
              </svg>{c.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="rail" id="stats">
      {hero.stats.map((s) => (
        <div class="stat">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {s.icon === 'cal' && (
              <Fragment><rect pathLength="1" x="3" y="5" width="18" height="16" rx="2" /><path pathLength="1" d="M8 2v6M16 2v6M3 11h18" /></Fragment>
            )}
            {s.icon === 'pin' && (
              <Fragment><path pathLength="1" d="M12 22s8-7.500 8-13a8 8 0 1 0-16 0c0 5.500 8 13 8 13Z" /><circle pathLength="1" cx="12" cy="9" r="3" /></Fragment>
            )}
            {s.icon === 'people' && (
              <Fragment><circle pathLength="1" cx="9" cy="8" r="3" /><path pathLength="1" d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v3" /></Fragment>
            )}
            {s.icon === 'globe' && (
              <Fragment><circle pathLength="1" cx="12" cy="12" r="9" /><ellipse pathLength="1" cx="12" cy="12" rx="4" ry="9" /><path pathLength="1" d="M3 12h18" /></Fragment>
            )}
          </svg>
          <div><dt>{s.label}</dt><dd data-count={s.value}>{s.value}</dd></div>
        </div>
      ))}
    </dl>
  </div>
</section>
