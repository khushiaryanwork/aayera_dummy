---
import { faqs } from '@/data/content';
---

<section class="section light" id="faq" style="padding-top:0">
  <div class="wrap faq">
    <div data-r>
      <div class="eyebrow">Questions</div>
      <h2>Before we connect.</h2>
    </div>
    <div class="faq-list" data-r style="--d:1">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>
