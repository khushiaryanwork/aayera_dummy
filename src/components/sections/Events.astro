---
import EventsCarousel from '@/components/islands/EventsCarousel';
import { formatDateRange } from '@/content/format';
import type { PageContent } from '@/content/types';

interface Props {
  events: PageContent['events'];
}
const { events } = Astro.props;
const items = events.items.map((e) => ({ ...e, dates: formatDateRange(e.startDate, e.endDate) }));
---

<section class="section dark events" id="events">
  <EventsCarousel client:visible heading={events.heading} events={items} />
</section>
