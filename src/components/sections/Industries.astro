---
import EnergyScene from '@/components/scenes/EnergyScene.astro';
import MobilityScene from '@/components/scenes/MobilityScene.astro';
import HealthScene from '@/components/scenes/HealthScene.astro';
import TechScene from '@/components/scenes/TechScene.astro';
import type { EventItem, PageContent } from '@/content/types';

interface Props {
  industries: PageContent['industries'];
  events: EventItem[];
}
const { industries, events } = Astro.props;

const scenes = { energy: EnergyScene, mobility: MobilityScene, health: HealthScene, tech: TechScene };
const eventCount = (sector: string) => {
  const n = events.filter((e) => e.sector === sector).length;
  return `${n} event${n === 1 ? '' : 's'}`;
};
const { heading } = industries;
---

<!-- Each tile links to the events carousel, pre-filtered via data-goto (see src/scripts/intents.ts) -->
<section class="section dark" id="industries">
  <div class="wrap">
    <div class="head" data-r>
      <div>
        <div class="eyebrow">{heading.eyebrow}</div>
        <h2>{heading.heading}{heading.highlight && <Fragment> <span class="gold">{heading.highlight}</span></Fragment>}</h2>
      </div>
      {heading.intro && <p class="lede">{heading.intro}</p>}
    </div>
    <div class="bento">
      {industries.items.map((item) => {
        const Scene = scenes[item.sector];
        return (
          <a class="tile" href="#events" data-goto={item.sector}>
            {Scene && <Scene />}
            <div class="tile-body">
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
              <span class="arrow-link">{eventCount(item.sector)} <svg aria-hidden="true"><use href="#arrow"></use></svg></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
