---
/** Sector tiles. Each links to the events carousel pre-filtered via data-goto. */
---

<section class="section dark" id="industries">
  <div class="wrap">
    <div class="head" data-r>
      <div>
        <div class="eyebrow">Industries in focus</div>
        <h2>Different worlds. <span class="gold">One shared future.</span></h2>
      </div>
      <p class="lede">Specialist conversations around the challenges and opportunities that matter.</p>
    </div>
    <div class="bento">
      <a class="tile" href="#events" data-goto="energy">
        <svg class="scene" viewBox="0 0 560 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="s-faint" d="M-400 120H200M360 120H960"/>
          <path class="s-gold flow" d="M-400 120H200"/>
          <path class="s-gold flow" d="M360 120H960"/>
          <rect class="s-body" x="200" y="40" width="160" height="160" rx="16"/>
          <path class="s-line" d="M232 142a48 48 0 0 1 96 0"/>
          <path class="s-gold needle" d="M280 142V100"/>
          <circle class="s-fill" cx="280" cy="142" r="5"/>
          <rect class="s-faint" x="232" y="158" width="96" height="24" rx="4"/>
          <rect class="s-fill cell" style="--i:0" x="240" y="164" width="14" height="12" rx="2"/>
          <rect class="s-fill cell" style="--i:1" x="260" y="164" width="14" height="12" rx="2"/>
          <rect class="s-fill cell" style="--i:2" x="280" y="164" width="14" height="12" rx="2"/>
          <rect class="s-fill cell" style="--i:3" x="300" y="164" width="14" height="12" rx="2"/>
          <path class="s-fill bolt" d="M120 76l-16 28h12l-6 22 20-30h-13l8-20Z"/>
          <path class="s-fill bolt" style="animation-delay:.7s" d="M446 76l-16 28h12l-6 22 20-30h-13l8-20Z"/>
        </svg>
        <div class="tile-body"><div><h3>Energy &amp; utilities</h3><p>Smart metering and the distribution companies behind it.</p></div><span class="arrow-link">1 event <svg aria-hidden="true"><use href="#arrow"/></svg></span></div>
      </a>

      <a class="tile" href="#events" data-goto="mobility">
        <svg class="scene" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="s-faint" d="M-300 196H700"/>
          <rect class="s-body" x="48" y="72" width="52" height="124" rx="8"/>
          <rect class="s-faint" x="60" y="86" width="28" height="44" rx="4"/>
          <rect class="s-fill cell" style="--i:3" x="65" y="92" width="18" height="6"/>
          <rect class="s-fill cell" style="--i:2" x="65" y="101" width="18" height="6"/>
          <rect class="s-fill cell" style="--i:1" x="65" y="110" width="18" height="6"/>
          <rect class="s-fill cell" style="--i:0" x="65" y="119" width="18" height="6"/>
          <path class="s-faint" d="M100 150C150 210 180 190 212 156"/>
          <path class="s-gold flow" d="M100 150C150 210 180 190 212 156"/>
          <path class="s-body" d="M186 174v-26l32-34c6-6 12-8 20-8h60c8 0 14 3 20 9l28 33 28 8c6 2 8 6 8 12v6Z"/>
          <path class="s-faint" d="M232 118h28v30h-56ZM272 118h28c5 0 9 2 12 6l20 24h-60Z"/>
          <circle class="s-body" cx="228" cy="178" r="18"/>
          <circle class="s-body" cx="340" cy="178" r="18"/>
          <path class="s-fill bolt" d="M72 138l-9 15h7l-3 12 12-16h-8l5-11Z"/>
        </svg>
        <div class="tile-body"><div><h3>Mobility &amp; transport</h3><p>EV charging and hybrid electric vehicles.</p></div><span class="arrow-link">2 events <svg aria-hidden="true"><use href="#arrow"/></svg></span></div>
      </a>

      <a class="tile" href="#events" data-goto="health">
        <svg class="scene" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="s-faint" d="M-300 130H110L126 130 140 80 160 180 178 110 190 130H270"/>
          <path class="s-gold ecg" pathLength="1" d="M-300 130H110L126 130 140 80 160 180 178 110 190 130H270"/>
          <circle class="ring" style="--i:0" cx="326" cy="130" r="42"/>
          <circle class="ring" style="--i:1.5" cx="326" cy="130" r="42"/>
          <g class="heart"><path class="s-fill" d="M314 96h24v22h22v24h-22v22h-24v-22h-22v-24h22Z"/></g>
        </svg>
        <div class="tile-body"><div><h3>Healthcare</h3><p>Project delivery, manufacturing and distribution.</p></div><span class="arrow-link">3 events <svg aria-hidden="true"><use href="#arrow"/></svg></span></div>
      </a>

      <a class="tile" href="#events" data-goto="tech">
        <svg class="scene" viewBox="0 0 560 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="ring" style="--i:0" cx="280" cy="120" r="70"/>
          <circle class="ring" style="--i:1" cx="280" cy="120" r="70"/>
          <circle class="ring" style="--i:2" cx="280" cy="120" r="70"/>
          <g class="s-faint"><path d="M280 120L120 60M280 120L100 170M280 120L190 30M280 120L440 60M280 120L460 170M280 120L370 210"/></g>
          <path class="s-gold packet" style="--i:0" pathLength="1" d="M120 60L280 120"/>
          <path class="s-gold packet" style="--i:1" pathLength="1" d="M280 120L460 170"/>
          <path class="s-gold packet" style="--i:2" pathLength="1" d="M100 170L280 120"/>
          <path class="s-gold packet" style="--i:3" pathLength="1" d="M280 120L440 60"/>
          <path class="s-gold packet" style="--i:4" pathLength="1" d="M190 30L280 120"/>
          <path class="s-gold packet" style="--i:5" pathLength="1" d="M280 120L370 210"/>
          <g class="s-body">
            <circle cx="120" cy="60" r="11"/><circle cx="100" cy="170" r="11"/><circle cx="190" cy="30" r="11"/>
            <circle cx="440" cy="60" r="11"/><circle cx="460" cy="170" r="11"/><circle cx="370" cy="210" r="11"/>
          </g>
          <rect class="s-fill" x="256" y="96" width="48" height="48" rx="10"/>
          <path d="M268 120h24M280 108v24" fill="none" stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <div class="tile-body"><div><h3>Technology</h3><p>The Internet of Things and commercialising new research.</p></div><span class="arrow-link">1 event <svg aria-hidden="true"><use href="#arrow"/></svg></span></div>
      </a>
    </div>
  </div>
</section>
