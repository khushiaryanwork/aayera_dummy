---
import Crossfade from '@/components/islands/Crossfade';
import type { PageContent } from '@/content/types';

interface Props {
  why: PageContent['why'];
}
const { why } = Astro.props;
---

<section class="section dark why" id="why">
  <div class="wrap why-grid">
    <div class="why-card" data-r>
      <div>
        <div class="eyebrow">{why.heading.eyebrow}</div>
        <h2>{why.heading.heading}</h2>
      </div>
      <Crossfade client:visible className="why-photo" slides={why.photos} />
    </div>
    <div class="reasons">
      {why.reasons.map((r, i) => (
        <div class="reason" data-r style={i % 2 ? '--d:1' : undefined}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            {r.icon === 'people' && (
              <Fragment><circle cx="24" cy="14" r="7" /><circle cx="10" cy="34" r="5" /><circle cx="38" cy="34" r="5" /><path d="M19 20l-6 10M29 20l6 10M15 34h18" /></Fragment>
            )}
            {r.icon === 'chat' && <Fragment><path d="M6 10h28v20H18l-8 8v-8H6Z" /><path d="M38 18h4v18h-4v6l-6-6H22" /></Fragment>}
            {r.icon === 'globe' && (
              <Fragment><circle cx="24" cy="24" r="18" /><ellipse cx="24" cy="24" rx="8" ry="18" /><path d="M6 24h36M9 14h30M9 34h30" /></Fragment>
            )}
            {r.icon === 'clipboard' && <Fragment><rect x="10" y="8" width="28" height="34" rx="3" /><path d="M18 8V4h12v4M17 20h14M17 28h14M17 36h8" /></Fragment>}
          </svg>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
          <a class="btn btn-line" href={r.target}>{r.ctaLabel} <svg aria-hidden="true"><use href="#arrow"></use></svg></a>
        </div>
      ))}
    </div>
  </div>
</section>
