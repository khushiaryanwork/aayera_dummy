---
import Arrow from '@/components/ui/Arrow.astro';
import type { Img, PageContent } from '@/content/types';

interface Props {
  about: PageContent['about'];
}
const { about } = Astro.props;
const [wide, small1, small2] = about.photos as (Img | undefined)[];
const pos = (img?: Img) => (img?.position ? `object-position:${img.position}` : undefined);
---

<section class="section light about" id="about">
  <div class="wrap">
    <div class="about-head">
      <div class="eyebrow">{about.eyebrow}</div>
      <h2 class="fill" id="fill">{about.statement}</h2>
    </div>

    <div class="mosaic">
      {wide && (
        <figure class="m-photo m-wide par" data-r>
          <img src={wide.src} alt={wide.alt} loading="lazy" style={pos(wide)} />
          {wide.caption && <figcaption>{wide.caption}</figcaption>}
        </figure>
      )}

      <div class="m-tile m-copy" data-r style="--d:1">
        <p class="lede">{about.lede}</p>
        <p>{about.body}</p>
        <a class="btn btn-black" href="#services">{about.ctaLabel} <Arrow /></a>
      </div>

      <div class="m-tile m-steps" data-r style="--d:1">
        <span class="steps-line" aria-hidden="true"></span>
        {about.steps.map((s) => (
          <a class="step" href={s.target}><i aria-hidden="true"></i><span><strong>{s.title}</strong>{s.body}</span><Arrow /></a>
        ))}
      </div>

      {small1 && (
        <figure class="m-photo m-small par" data-r>
          <img src={small1.src} alt={small1.alt} loading="lazy" style={pos(small1)} />
        </figure>
      )}

      <div class="m-tile m-gold" data-r style="--d:1">
        <p>{about.motto.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
      </div>

      {small2 && (
        <figure class="m-photo m-small par" data-r style="--d:2">
          <img src={small2.src} alt={small2.alt} loading="lazy" style={pos(small2)} />
        </figure>
      )}
    </div>
  </div>
</section>
