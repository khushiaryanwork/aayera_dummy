---
/** Each card prefills the enquiry form's path via data-path (see src/scripts/intents.ts). */
---

<section class="section off" id="participate">
  <div class="wrap">
    <div class="head" data-r>
      <div>
        <div class="eyebrow">Ways to participate</div>
        <h2>There's a place for your ambition.</h2>
      </div>
    </div>
    <div class="ways">
      <a class="way way-black" href="#contact" data-path="attend">
        <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v16M12 5C8 2 5 3 2 4v15c3-1 6-2 10 2 4-4 7-3 10-2V4c-3-1-6-2-10 1Z"></path></svg></span>
        <span class="eyebrow">Attend</span>
        <h3>Come for the room and the conversation</h3>
        <ul><li>Relevant conferences and training</li><li>Perspectives from experts and peers</li><li>Business networking opportunities</li></ul>
        <span class="arrow-link">Enquire about programmes <svg aria-hidden="true"><use href="#arrow"></use></svg></span>
      </a>
      <a class="way" href="#contact" data-path="partner">
        <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="3"></circle><circle cx="5" cy="19" r="3"></circle><circle cx="19" cy="19" r="3"></circle><path d="m10 8-4 8M14 8l4 8M8 19h8"></path></svg></span>
        <span class="eyebrow">Partner &amp; exhibit</span>
        <h3>Put your brand in front of your industry</h3>
        <ul><li>Sponsorship opportunities</li><li>Exhibition space</li><li>Connected to your audience</li></ul>
        <span class="arrow-link">Explore partnerships <svg aria-hidden="true"><use href="#arrow"></use></svg></span>
      </a>
      <a class="way" href="#contact" data-path="organise">
        <span class="way-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="18" rx="2"></rect><path d="M9 4V2h6v2M8 9h8M8 13h8M8 17h5"></path></svg></span>
        <span class="eyebrow">Organise</span>
        <h3>Bring us your event brief</h3>
        <ul><li>Conference planning</li><li>Professional development</li><li>Speakers, registration and sponsors</li></ul>
        <span class="arrow-link">Discuss your brief <svg aria-hidden="true"><use href="#arrow"></use></svg></span>
      </a>
    </div>
  </div>
</section>
