---
import type { PageContent } from '@/content/types';

interface Props {
  participate: PageContent['participate'];
}
const { participate } = Astro.props;
---

<!-- Each card prefills the enquiry form's path via data-path (see src/scripts/intents.ts) -->
<section class="section off" id="participate">
  <div class="wrap">
    <div class="head" data-r>
      <div>
        <div class="eyebrow">{participate.heading.eyebrow}</div>
        <h2>{participate.heading.heading}</h2>
      </div>
    </div>
    <div class="ways">
      {participate.ways.map((w, i) => (
        <a class:list={['way', { 'way-black': i === 0 }]} href="#contact" data-path={w.path}>
          <span class="way-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {w.path === 'attend' && <path d="M12 5v16M12 5C8 2 5 3 2 4v15c3-1 6-2 10 2 4-4 7-3 10-2V4c-3-1-6-2-10 1Z" />}
              {w.path === 'partner' && (
                <Fragment><circle cx="12" cy="5" r="3" /><circle cx="5" cy="19" r="3" /><circle cx="19" cy="19" r="3" /><path d="m10 8-4 8M14 8l4 8M8 19h8" /></Fragment>
              )}
              {w.path === 'organise' && <Fragment><rect x="4" y="4" width="16" height="18" rx="2" /><path d="M9 4V2h6v2M8 9h8M8 13h8M8 17h5" /></Fragment>}
            </svg>
          </span>
          <span class="eyebrow">{w.label}</span>
          <h3>{w.title}</h3>
          <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
          <span class="arrow-link">{w.ctaLabel} <svg aria-hidden="true"><use href="#arrow"></use></svg></span>
        </a>
      ))}
    </div>
  </div>
</section>
