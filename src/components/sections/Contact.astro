---
import EnquiryForm from '@/components/islands/EnquiryForm';
import type { PageContent } from '@/content/types';

interface Props {
  contact: PageContent['contact'];
  site: PageContent['site'];
}
const { contact, site } = Astro.props;
const { heading } = contact;
const { address } = site;
---

<section class="section dark contact" id="contact">
  <div class="wrap contact-grid">
    <div class="contact-intro" data-r>
      <div>
        <div class="eyebrow">{heading.eyebrow}</div>
        <h2>{heading.heading}{heading.highlight && <Fragment> <span class="grad">{heading.highlight}</span></Fragment>}</h2>
      </div>
      {heading.intro && <p class="lede">{heading.intro}</p>}
      <div class="direct">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phones.map((p) => <a href={p.href}>{p.label}</a>)}
        <address>{[address.street, address.area].filter(Boolean).join(', ')}<br />{address.city} {address.postalCode}, {address.country}</address>
      </div>
    </div>

    <EnquiryForm client:load email={site.email} />
  </div>
</section>
