---
import { splitIntoRows } from '@/content/format';
import type { PageContent } from '@/content/types';

interface Props {
  clients: PageContent['clients'];
}
const { clients } = Astro.props;
const rows = splitIntoRows(clients.logos);
---

<section class="section light clients" id="clients">
  <div class="wrap head" data-r>
    <div>
      <div class="eyebrow">{clients.heading.eyebrow}</div>
      <h2>{clients.heading.heading}</h2>
    </div>
    {clients.heading.intro && <p class="lede">{clients.heading.intro}</p>}
  </div>
  {rows.map((row) => (
    <div class:list={['marquee', { rev: row.reverse }]} style={`--t:${row.duration}`}>
      <ul class="m-group">
        {row.clients.map((c) => (
          <li><img src={c.logo} alt={c.name} width="230" height="120" /></li>
        ))}
      </ul>
    </div>
  ))}
</section>
