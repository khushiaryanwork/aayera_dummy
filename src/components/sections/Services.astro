---
import ServicesAccordion from '@/components/islands/ServicesAccordion';
import type { PageContent } from '@/content/types';

interface Props {
  services: PageContent['services'];
}
const { services } = Astro.props;
---

<section class="section light" id="services">
  <div class="wrap">
    <div class="head" data-r>
      <div>
        <div class="eyebrow">{services.heading.eyebrow}</div>
        <h2>{services.heading.heading}</h2>
      </div>
      {services.heading.intro && <p class="lede">{services.heading.intro}</p>}
    </div>
    <ServicesAccordion client:visible services={services.items} />
  </div>
</section>
